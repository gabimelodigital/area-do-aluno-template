# ÁREA DO ALUNO — variáveis de ambiente
#
# Este arquivo é só a LISTA do que configurar. Não coloque valores reais aqui.
# Na Vercel: Settings > Environment Variables.
# No computador (para rodar local): crie um arquivo .env.local (ele NÃO sobe pro GitHub)
# copiando estas linhas e preenchendo os valores.

# --- Supabase (Project Settings > API) ---
# Públicas: vão para o navegador; a segurança fica nas regras (RLS) do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: só servidor. Usada pelo webhook da Guru e para criar alunos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dono da área ---
# Seu e-mail. A página /instalar cria sua conta de admin com ele e a senha padrão.
EMAIL_DONO=

# --- Guru ---
# Token da sua conta Guru (Meu Perfil > Tokens API). O webhook só aceita vendas com ele.
GURU_API_TOKEN=
# Senha que todo aluno novo recebe (mínimo 8 caracteres). Mande junto no SIV.
SENHA_PADRAO_ALUNO=

# --- BIA (assistente de dúvidas) ---
# Chave da API da Anthropic (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-5-5 (mais barato). Outras: claude-sonnet-5-5, claude-opus-5-5.
BIA_MODELO=
